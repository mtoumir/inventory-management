generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Materials {
  codeSAP       String    @id @unique
  designation   String?
  unit          String?
  typeArticle   String?
  PU            Float?    // Prix Unitaire
  quantity      Int?      // Stock quantity
  cout          Float?    // Coût total
  imputation    String?
  desImputation String?
  sorties       Sorties[] @relation("MaterialSorties")
}

model Sorties {
  sortieId   String     @id @default(uuid())
  codeSAP    String     // FK to Materials
  quantity   Int?       
  timeStamp  DateTime?  @default(now())
  userName   String?
  material   Materials  @relation("MaterialSorties", fields: [codeSAP], references: [codeSAP])
  productions Productions[]
}

model Productions {
  productionId  String     @id @default(uuid())
  sortieId      String     
  quantity      Int?       
  wasteQuantity Int?       
  timeStamp     DateTime?  @default(now())
  sortie        Sorties    @relation(fields: [sortieId], references: [sortieId])  
}

model Shift {
  id            String        @id @default(uuid())
  shiftType     ShiftType     
  date          DateTime      
  technicien    String?
  totalWasted   Int?
  createdAt     DateTime      @default(now())


  wastedEntries WastedEntry[]
}

model WastedEntry {
  id         String   @id @default(uuid())
  category   CategoryType
  problem    ProblemType
  Quantity     Int
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
}

enum ShiftType {
  MORNING
  MIDDAY
  NIGHT
}

enum CategoryType {
  PRODUCTION
  MAINTENANCE
  OTHER
}

enum ProblemType {
  MACHINE
  MATERIAL
  OTHER
}







